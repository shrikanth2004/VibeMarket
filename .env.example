# Supabase credentials (get these from your Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Setup (emails in this list will automatically have admin status in the app)
ADMIN_EMAILS=admin@example.com,seller@example.com
